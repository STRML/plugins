+        .{ .L = 256, .nb = 50000, .r = 2, .tile = 8192, .distinct = 700 },
+        .{ .L = 128, .nb = 40000, .r = 1, .tile = 32768, .distinct = 997 },
+        .{ .L = 40, .nb = 3000, .r = 1, .tile = 64, .distinct = 37 },
